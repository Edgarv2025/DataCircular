// DATA_CIRCULAR - Prisma Schema
// Fundación IMARA - Proyecto de Economía Circular

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estados posibles de una cuenta de usuario
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Roles del sistema
enum UserRole {
  USER
  ADMIN
}

/// Tipos de participantes de la economía circular
enum UserType {
  GENERATOR
  RECYCLER
  TRANSPORTER
  TRANSFORMER
}

enum DataPolicyAcceptanceStatus {
  ACCEPTED
  WITHDRAWN
}

/// Entidad principal de Usuario
model User {
  id           String      @id @default(uuid()) @db.Uuid
  fullName     String      @map("full_name") @db.VarChar(150)
  email        String      @unique @db.VarChar(255)
  phone        String?     @db.VarChar(30)
  userType     UserType    @default(GENERATOR) @map("user_type")
  passwordHash String      @map("password_hash") @db.VarChar(255)
  status       UserStatus  @default(ACTIVE)
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)
  dataPolicyAcceptance DataPolicyAcceptance?
  memberships  OrganizationMember[] @relation("UserMemberships")
  invitedMembers OrganizationMember[] @relation("InvitedMembers")
  publications MaterialPublication[] @relation("UserPublications")

  @@index([status, deletedAt])
  @@index([email])
  @@map("users")
}

model DataPolicyAcceptance {
  id            String                      @id @default(uuid()) @db.Uuid
  userId        String                      @unique @map("user_id") @db.Uuid
  acceptedAt    DateTime                    @default(now()) @map("accepted_at") @db.Timestamptz(6)
  policyVersion String                      @map("policy_version") @db.VarChar(100)
  policyUrl     String?                     @map("policy_url") @db.Text
  status        DataPolicyAcceptanceStatus  @default(ACCEPTED)
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("data_policy_acceptances")
}

/// Tipos de organización en la economía circular
enum OrganizationType {
  COMPANY      // Empresa comercial
  ASSOCIATION  // Asociación de recicladores de oficio
  FOUNDATION   // Fundación sin ánimo de lucro
  COOPERATIVE  // Cooperativa
  INSTITUTION  // Entidad pública o institucional
}

/// Estados operativos de la organización
enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Estados del proceso de verificación o certificación institucional
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// Estados de la membresía de un usuario en una organización
enum MembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
}

/// Entidad de Organizaciones y Empresas
model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(150)
  legalName          String?            @map("legal_name") @db.VarChar(200)
  taxId              String?            @unique @map("tax_id") @db.VarChar(50)
  orgType            OrganizationType   @default(COMPANY) @map("org_type")
  activityType       UserType           @default(GENERATOR) @map("activity_type")
  email              String?            @db.VarChar(255)
  phone              String?            @db.VarChar(30)
  address            String?            @db.VarChar(255)
  locality           String?            @db.VarChar(100)
  city               String             @default("Bogotá D.C.") @db.VarChar(100)
  status             OrganizationStatus @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  verificationNotes  String?            @map("verification_notes") @db.Text
  certificateUrl     String?            @map("certificate_url") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)

  members            OrganizationMember[]
  roles              Role[]
  publications       MaterialPublication[] @relation("OrganizationPublications")

  @@index([status, deletedAt])
  @@index([orgType])
  @@index([locality])
  @@map("organizations")
}

/// Roles dentro de las organizaciones (distintos de los roles de plataforma)
model Role {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String?         @map("organization_id") @db.Uuid
  name           String          @db.VarChar(50)
  description    String?         @db.VarChar(255)
  isSystem       Boolean         @default(false) @map("is_system")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        OrganizationMember[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// Permisos granulares de organización
model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  roles       RolePermission[]

  @@map("permissions")
}

/// Asociación entre Roles y Permisos (Muchos a Muchos)
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Membresía y vinculación de un Usuario con una Organización
model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("InvitedMembers", fields: [invitedById], references: [id], onDelete: SetNull)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

/// Tipos de publicación (oferta de material o necesidad de material)
enum PublicationType {
  OFFER
  NEED
}

/// Estados de la publicación
enum PublicationStatus {
  ACTIVE
  PAUSED
  CLOSED
  EXPIRED
}

/// Categoría o subcategoría de material aprovechable (soporte jerárquico)
model MaterialCategory {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(100)
  description String?            @db.VarChar(255)
  parentId    String?            @map("parent_id") @db.Uuid
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent        MaterialCategory?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories MaterialCategory[]    @relation("CategoryHierarchy")
  publications  MaterialPublication[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([active])
  @@map("material_categories")
}

/// Unidad de medida para publicaciones de material (ej. Kilogramo, Tonelada)
model Unit {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique @db.VarChar(50)
  abbreviation String             @unique @db.VarChar(10)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  publications MaterialPublication[]

  @@map("units")
}

/// Publicación de oferta o necesidad de material aprovechable
model MaterialPublication {
  id              String            @id @default(uuid()) @db.Uuid
  type            PublicationType
  ownerUserId     String            @map("owner_user_id") @db.Uuid
  organizationId  String?           @map("organization_id") @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  quantity        Decimal           @db.Decimal(12, 2)
  unitId          String            @map("unit_id") @db.Uuid
  locationAddress String            @map("location_address") @db.VarChar(255)
  locationCity    String?           @default("Bogotá D.C.") @map("location_city") @db.VarChar(100)
  locationArea    String?           @map("location_area") @db.VarChar(100)
  condition       String?           @db.VarChar(100)
  photoUrl        String?           @map("photo_url") @db.Text
  isUrgent        Boolean           @default(false) @map("is_urgent")
  status          PublicationStatus @default(ACTIVE)
  expiresAt       DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  ownerUser    User              @relation("UserPublications", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organization Organization?     @relation("OrganizationPublications", fields: [organizationId], references: [id], onDelete: SetNull)
  category     MaterialCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([type])
  @@index([status, deletedAt])
  @@index([ownerUserId])
  @@index([organizationId])
  @@index([categoryId])
  @@map("material_publications")
}


