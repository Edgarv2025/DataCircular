// DATA_CIRCULAR - Prisma Schema
// Fundación IMARA - Proyecto de Economía Circular

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

