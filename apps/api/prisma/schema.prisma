// DATA_CIRCULAR - Prisma Schema
// Fundación IMARA - Proyecto de Economía Circular

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

model OrganizationMaterialCategory {
  organizationId String           @map("organization_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([organizationId, categoryId])
  @@index([categoryId])
  @@map("organization_material_categories")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estados posibles de una cuenta de usuario
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Roles del sistema
enum UserRole {
  USER
  ADMIN
}

/// Tipos de participantes de la economía circular
enum UserType {
  GENERATOR
  RECYCLER
  TRANSPORTER
  TRANSFORMER
}

enum DataPolicyAcceptanceStatus {
  ACCEPTED
  WITHDRAWN
}

/// Entidad principal de Usuario
model User {
  id           String      @id @default(uuid()) @db.Uuid
  fullName     String      @map("full_name") @db.VarChar(150)
  email        String      @unique @db.VarChar(255)
  phone        String?     @db.VarChar(30)
  userType     UserType    @default(GENERATOR) @map("user_type")
  passwordHash String      @map("password_hash") @db.VarChar(255)
  status       UserStatus  @default(ACTIVE)
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)
  dataPolicyAcceptance DataPolicyAcceptance?
  memberships  OrganizationMember[] @relation("UserMemberships")
  invitedMembers OrganizationMember[] @relation("InvitedMembers")
  publications MaterialPublication[] @relation("UserPublications")
  transportMaterialCategories TransportMaterialCategory[]
  initiatedConversations Conversation[] @relation("InitiatedConversations")
  counterpartConversations Conversation[] @relation("CounterpartConversations")
  conversationStates ConversationParticipantState[]
  sentMessages Message[] @relation("SentMessages")
  proposals Proposal[] @relation("UserProposals")
  respondedProposals Proposal[] @relation("UserRespondedProposals")
  operationsAsSeller Operation[] @relation("SellerOperations")
  operationsAsBuyer  Operation[] @relation("BuyerOperations")
  operationsAsTransporter Operation[] @relation("TransporterOperations")
  operationEvidences OperationEvidence[] @relation("UploadedEvidences")
  givenReviews       OperationReview[] @relation("GivenReviews")
  receivedReviews    OperationReview[] @relation("ReceivedReviews")

  @@index([status, deletedAt])
  @@index([email])
  @@map("users")
}

model DataPolicyAcceptance {
  id            String                      @id @default(uuid()) @db.Uuid
  userId        String                      @unique @map("user_id") @db.Uuid
  acceptedAt    DateTime                    @default(now()) @map("accepted_at") @db.Timestamptz(6)
  policyVersion String                      @map("policy_version") @db.VarChar(100)
  policyUrl     String?                     @map("policy_url") @db.Text
  status        DataPolicyAcceptanceStatus  @default(ACCEPTED)
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("data_policy_acceptances")
}

/// Tipos de organización en la economía circular
enum OrganizationType {
  COMPANY      // Empresa comercial
  ASSOCIATION  // Asociación de recicladores de oficio
  FOUNDATION   // Fundación sin ánimo de lucro
  COOPERATIVE  // Cooperativa
  INSTITUTION  // Entidad pública o institucional
}

/// Estados operativos de la organización
enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Estados del proceso de verificación o certificación institucional
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// Estados de la membresía de un usuario en una organización
enum MembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
}

/// Entidad de Organizaciones y Empresas
model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(150)
  legalName          String?            @map("legal_name") @db.VarChar(200)
  taxId              String?            @unique @map("tax_id") @db.VarChar(50)
  orgType            OrganizationType   @default(COMPANY) @map("org_type")
  activityType       UserType           @default(GENERATOR) @map("activity_type")
  email              String?            @db.VarChar(255)
  phone              String?            @db.VarChar(30)
  address            String?            @db.VarChar(255)
  locality           String?            @db.VarChar(100)
  city               String             @default("Bogotá D.C.") @db.VarChar(100)
  status             OrganizationStatus @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  verificationNotes  String?            @map("verification_notes") @db.Text
  certificateUrl     String?            @map("certificate_url") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)

  members            OrganizationMember[]
  materialCategories OrganizationMaterialCategory[]
  roles              Role[]
  publications       MaterialPublication[] @relation("OrganizationPublications")
  initiatedConversations Conversation[] @relation("OrgInitiatedConversations")
  counterpartConversations Conversation[] @relation("OrgCounterpartConversations")
  proposals          Proposal[] @relation("OrgProposals")
  sellerOperations   Operation[] @relation("OrgSellerOperations")
  buyerOperations    Operation[] @relation("OrgBuyerOperations")

  @@index([status, deletedAt])
  @@index([orgType])
  @@index([locality])
  @@map("organizations")
}

/// Roles dentro de las organizaciones (distintos de los roles de plataforma)
model Role {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String?         @map("organization_id") @db.Uuid
  name           String          @db.VarChar(50)
  description    String?         @db.VarChar(255)
  isSystem       Boolean         @default(false) @map("is_system")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  members        OrganizationMember[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// Permisos granulares de organización
model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  module      String           @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  roles       RolePermission[]

  @@map("permissions")
}

/// Asociación entre Roles y Permisos (Muchos a Muchos)
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Membresía y vinculación de un Usuario con una Organización
model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("InvitedMembers", fields: [invitedById], references: [id], onDelete: SetNull)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

/// Tipos de publicación (oferta de material o necesidad de material)
enum PublicationType {
  OFFER
  NEED
}

/// Estados de la publicación
enum PublicationStatus {
  ACTIVE
  PAUSED
  CLOSED
  EXPIRED
}

/// Categoría o subcategoría de material aprovechable (soporte jerárquico)
model MaterialCategory {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(100)
  description String?            @db.VarChar(255)
  parentId    String?            @map("parent_id") @db.Uuid
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent        MaterialCategory?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories MaterialCategory[]    @relation("CategoryHierarchy")
  publications  MaterialPublication[]
  transporters  TransportMaterialCategory[]
  organizations OrganizationMaterialCategory[]
  operations    Operation[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([active])
  @@map("material_categories")
}

/// Unidad de medida para publicaciones de material (ej. Kilogramo, Tonelada)
model Unit {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @unique @db.VarChar(50)
  abbreviation String             @unique @db.VarChar(10)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  publications MaterialPublication[]
  proposals    Proposal[]
  operations   Operation[]

  @@map("units")
}

model TransportMaterialCategory {
  userId     String           @map("user_id") @db.Uuid
  categoryId String           @map("category_id") @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
  @@map("transport_material_categories")
}

/// Publicación de oferta de material aprovechable
model MaterialPublication {
  id              String            @id @default(uuid()) @db.Uuid
  type            PublicationType
  ownerUserId     String            @map("owner_user_id") @db.Uuid
  organizationId  String?           @map("organization_id") @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  quantity        Decimal           @db.Decimal(12, 2)
  unitId          String            @map("unit_id") @db.Uuid
  description     String?           @db.Text
  requiresTransport Boolean         @default(false) @map("requires_transport")
  locationAddress String            @map("location_address") @db.VarChar(255)
  locationCity    String?           @default("Bogotá D.C.") @map("location_city") @db.VarChar(100)
  locationArea    String?           @map("location_area") @db.VarChar(100)
  condition       String?           @db.VarChar(100)
  photoUrl        String?           @map("photo_url") @db.Text
  isUrgent        Boolean           @default(false) @map("is_urgent")
  status          PublicationStatus @default(ACTIVE)
  expiresAt       DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  ownerUser     User              @relation("UserPublications", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organization  Organization?     @relation("OrganizationPublications", fields: [organizationId], references: [id], onDelete: SetNull)
  category      MaterialCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit          Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  conversations Conversation[]
  proposals     Proposal[]
  operations    Operation[]

  @@index([type])
  @@index([status, deletedAt])
  @@index([ownerUserId])
  @@index([organizationId])
  @@index([categoryId])
  @@map("material_publications")
}

/// Estados de una conversación
enum ConversationStatus {
  OPEN
  ARCHIVED
  BLOCKED
}

/// Tipos de mensaje dentro de una conversación
enum MessageType {
  TEXT
  SYSTEM
}

/// Estados del ciclo de vida de una propuesta formal
enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

/// Conversación entre dos partes originada desde una publicación
model Conversation {
  id                        String              @id @default(uuid()) @db.Uuid
  publicationId             String              @map("publication_id") @db.Uuid
  initiatorUserId           String              @map("initiator_user_id") @db.Uuid
  initiatorOrganizationId   String?             @map("initiator_organization_id") @db.Uuid
  counterpartUserId         String              @map("counterpart_user_id") @db.Uuid
  counterpartOrganizationId String?             @map("counterpart_organization_id") @db.Uuid
  status                    ConversationStatus  @default(OPEN)
  lastMessageAt             DateTime?           @map("last_message_at") @db.Timestamptz(6)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  publication               MaterialPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  initiatorUser             User                @relation("InitiatedConversations", fields: [initiatorUserId], references: [id], onDelete: Cascade)
  initiatorOrganization     Organization?       @relation("OrgInitiatedConversations", fields: [initiatorOrganizationId], references: [id], onDelete: SetNull)
  counterpartUser           User                @relation("CounterpartConversations", fields: [counterpartUserId], references: [id], onDelete: Cascade)
  counterpartOrganization   Organization?       @relation("OrgCounterpartConversations", fields: [counterpartOrganizationId], references: [id], onDelete: SetNull)

  participantStates         ConversationParticipantState[]
  messages                  Message[]
  proposals                 Proposal[]

  @@unique([publicationId, initiatorUserId])
  @@index([publicationId])
  @@index([initiatorUserId])
  @@index([counterpartUserId])
  @@index([lastMessageAt])
  @@index([status])
  @@map("conversations")
}

/// Estado por participante en una conversación (lectura y archivado independiente)
model ConversationParticipantState {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participant_states")
}

/// Mensaje intercambiado en una conversación (inmutable)
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderUserId   String?     @map("sender_user_id") @db.Uuid
  body           String      @db.Text
  type           MessageType @default(TEXT)
  metadata       Json?       @db.JsonB
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User?        @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Propuesta formal o contrapropuesta dentro de una negociación
model Proposal {
  id                     String         @id @default(uuid()) @db.Uuid
  conversationId         String         @map("conversation_id") @db.Uuid
  publicationId          String         @map("publication_id") @db.Uuid
  proposerUserId         String         @map("proposer_user_id") @db.Uuid
  proposerOrganizationId String?        @map("proposer_organization_id") @db.Uuid
  quantity               Decimal        @db.Decimal(12, 2)
  unitId                 String         @map("unit_id") @db.Uuid
  terms                  String         @db.Text
  status                 ProposalStatus @default(PENDING)
  parentProposalId       String?        @map("parent_proposal_id") @db.Uuid
  respondedByUserId      String?        @map("responded_by_user_id") @db.Uuid
  respondedAt            DateTime?      @map("responded_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation           Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  publication            MaterialPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  proposerUser           User                @relation("UserProposals", fields: [proposerUserId], references: [id], onDelete: Cascade)
  proposerOrganization   Organization?       @relation("OrgProposals", fields: [proposerOrganizationId], references: [id], onDelete: SetNull)
  unit                   Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  parentProposal         Proposal?           @relation("ProposalHierarchy", fields: [parentProposalId], references: [id], onDelete: SetNull)
  counterProposals       Proposal[]          @relation("ProposalHierarchy")
  respondedByUser        User?               @relation("UserRespondedProposals", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  operation              Operation?

  @@index([conversationId])
  @@index([publicationId])
  @@index([proposerUserId])
  @@index([status])
  @@map("proposals")
}

/// Estados del ciclo de vida de una operación logística (Fase 11)
enum OperationStatus {
  ACCEPTED
  SCHEDULED
  COLLECTING
  EVIDENCE
  RECEIVED
  CLOSED
  CANCELLED
}

/// Tipos de evidencia asociados a una operación (Fase 11)
enum EvidenceType {
  WEIGHING_TICKET
  PHOTO
  SIGNATURE
  DOCUMENT
}

/// Operación de economía circular y logística
model Operation {
  id                        String              @id @default(uuid()) @db.Uuid
  code                      String              @unique @db.VarChar(50)
  proposalId                String              @unique @map("proposal_id") @db.Uuid
  publicationId             String              @map("publication_id") @db.Uuid
  sellerUserId              String              @map("seller_user_id") @db.Uuid
  sellerOrganizationId      String?             @map("seller_organization_id") @db.Uuid
  buyerUserId               String              @map("buyer_user_id") @db.Uuid
  buyerOrganizationId       String?             @map("buyer_organization_id") @db.Uuid
  transporterUserId         String?             @map("transporter_user_id") @db.Uuid
  transporterOrganizationId String?             @map("transporter_organization_id") @db.Uuid
  materialCategoryId        String              @map("material_category_id") @db.Uuid
  quantity                  Decimal             @db.Decimal(12, 2)
  unitId                    String              @map("unit_id") @db.Uuid
  agreedPriceCop            Decimal?            @map("agreed_price_cop") @db.Decimal(12, 2)
  status                    OperationStatus     @default(ACCEPTED)
  scheduledDate             DateTime?           @map("scheduled_date") @db.Timestamptz(6)
  scheduledTimeSlot         String?             @map("scheduled_time_slot") @db.VarChar(50)
  pickupAddress             String?             @map("pickup_address") @db.VarChar(255)
  pickupCity                String?             @default("Bogotá D.C.") @map("pickup_city") @db.VarChar(100)
  pickupArea                String?             @map("pickup_area") @db.VarChar(100)
  deliveryAddress           String?             @map("delivery_address") @db.VarChar(255)
  deliveryCity              String?             @default("Bogotá D.C.") @map("delivery_city") @db.VarChar(100)
  deliveryArea              String?             @map("delivery_area") @db.VarChar(100)
  transportNotes            String?             @map("transport_notes") @db.Text
  vehiclePlate              String?             @map("vehicle_plate") @db.VarChar(20)
  driverName                String?             @map("driver_name") @db.VarChar(100)
  actualWeight              Decimal?            @map("actual_weight") @db.Decimal(12, 2)
  receivedNotes             String?             @map("received_notes") @db.Text
  closedAt                  DateTime?           @map("closed_at") @db.Timestamptz(6)
  cancelledAt               DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason        String?             @map("cancellation_reason") @db.Text
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  proposal                  Proposal            @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  publication               MaterialPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  sellerUser                User                @relation("SellerOperations", fields: [sellerUserId], references: [id], onDelete: Restrict)
  sellerOrganization        Organization?       @relation("OrgSellerOperations", fields: [sellerOrganizationId], references: [id], onDelete: SetNull)
  buyerUser                 User                @relation("BuyerOperations", fields: [buyerUserId], references: [id], onDelete: Restrict)
  buyerOrganization         Organization?       @relation("OrgBuyerOperations", fields: [buyerOrganizationId], references: [id], onDelete: SetNull)
  transporterUser           User?               @relation("TransporterOperations", fields: [transporterUserId], references: [id], onDelete: SetNull)
  materialCategory          MaterialCategory    @relation(fields: [materialCategoryId], references: [id], onDelete: Restrict)
  unit                      Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  evidences                 OperationEvidence[]
  reviews                   OperationReview[]

  @@index([status])
  @@index([sellerUserId])
  @@index([buyerUserId])
  @@index([transporterUserId])
  @@index([pickupArea])
  @@index([createdAt])
  @@map("operations")
}

/// Evidencias documentales y de pesaje asociadas a una operación (Fase 11)
model OperationEvidence {
  id               String       @id @default(uuid()) @db.Uuid
  operationId      String       @map("operation_id") @db.Uuid
  type             EvidenceType
  fileUrl          String       @map("file_url") @db.Text
  description      String?      @db.Text
  weightKg         Decimal?     @map("weight_kg") @db.Decimal(12, 2)
  uploadedByUserId String       @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  operation        Operation    @relation(fields: [operationId], references: [id], onDelete: Cascade)
  uploadedByUser   User         @relation("UploadedEvidences", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@map("operation_evidences")
}

/// Evaluaciones y calificaciones de operaciones finalizadas (Fase 12)
model OperationReview {
  id                   String    @id @default(uuid()) @db.Uuid
  operationId          String    @map("operation_id") @db.Uuid
  reviewerUserId       String    @map("reviewer_user_id") @db.Uuid
  targetUserId         String    @map("target_user_id") @db.Uuid
  score                Int       @db.SmallInt
  punctualityScore     Int?      @map("punctuality_score") @db.SmallInt
  materialQualityScore Int?      @map("material_quality_score") @db.SmallInt
  fulfillmentScore     Int?      @map("fulfillment_score") @db.SmallInt
  comment              String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  operation            Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  reviewerUser         User      @relation("GivenReviews", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  targetUser           User      @relation("ReceivedReviews", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([operationId, reviewerUserId])
  @@index([operationId])
  @@index([targetUserId])
  @@map("operation_reviews")
}

