# DATA_CIRCULAR API - Variables de Entorno de Ejemplo
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/data_circular_dev?schema=public"

# Seguridad y Tokens
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_aleatorios
