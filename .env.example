# DATA_CIRCULAR - Variables de Entorno de Ejemplo
# IMPORTANTE: Copia este archivo a .env en apps/api o en la raíz para desarrollo local.
# NUNCA agregues contraseñas reales ni secretos en este archivo de ejemplo.

# Entorno de ejecución: development | test | production
NODE_ENV=development
PORT=3000

# Conexión a Base de Datos PostgreSQL
# Formato: postgresql://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/data_circular_dev?schema=public

# Seguridad y Autenticación JWT (para Fases siguientes)
JWT_SECRET=tu_secreto_jwt_de_al_menos_32_caracteres_aleatorios_aqui
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=tu_secreto_refresh_jwt_de_al_menos_32_caracteres_aqui
JWT_REFRESH_EXPIRES_IN=30d

# Configuración de CORS
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Política de Privacidad de Datos (Fundación IMARA)
DATA_POLICY_URL=
DATA_POLICY_VERSION=pendiente
